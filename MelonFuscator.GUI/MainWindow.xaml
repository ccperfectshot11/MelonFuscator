<Window x:Class="MelonFuscator.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MelonFuscator" Height="784" Width="560"
        MinHeight="680" MinWidth="520"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="{StaticResource Bg}"
        TextElement.Foreground="{StaticResource TextPrimary}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <StackPanel Grid.Row="0" Margin="4,0,4,18">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🍈" FontSize="26" VerticalAlignment="Center"/>
                <TextBlock Text="MelonFuscator" FontSize="24" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                <Border Background="{StaticResource SurfaceAlt}" CornerRadius="8" Padding="8,3" Margin="10,2,0,0" VerticalAlignment="Center">
                    <TextBlock Text="v1.0.0" FontSize="11" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
            <TextBlock Text="Aggressive, MelonLoader-friendly .NET obfuscator"
                       Foreground="{StaticResource TextSecond}" FontSize="12.5" Margin="1,6,0,0"/>
        </StackPanel>

        <!-- ===== Input card ===== -->
        <Border Grid.Row="1" Background="{StaticResource Surface}" CornerRadius="14" Padding="18"
                BorderBrush="{StaticResource Border}" BorderThickness="1" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="INPUT ASSEMBLY" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecond}" Margin="2,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtInput" Grid.Column="0" Height="44" Style="{StaticResource Field}"
                             ToolTip="Type or paste the path to your mod .dll"/>
                    <Button x:Name="btnOpen" Grid.Column="1" Content="Open" Width="96" Height="44"
                            Margin="10,0,0,0" Style="{StaticResource GhostButton}" Click="Open_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ===== Protections card ===== -->
        <Border Grid.Row="2" Background="{StaticResource Surface}" CornerRadius="14" Padding="18"
                BorderBrush="{StaticResource Border}" BorderThickness="1" Margin="0,0,0,14">
            <StackPanel>
                <Grid Margin="2,0,0,12">
                    <TextBlock Text="PROTECTIONS" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecond}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnAll" Content="all on" Width="52" Height="24" Margin="6,0,0,0"
                                Style="{StaticResource GhostButton}" FontSize="11" Click="All_Click"/>
                        <Button x:Name="btnNone" Content="all off" Width="54" Height="24" Margin="6,0,0,0"
                                Style="{StaticResource GhostButton}" FontSize="11" Click="None_Click"/>
                    </StackPanel>
                </Grid>
                <UniformGrid Columns="2">
                    <CheckBox x:Name="chkRename"         Style="{StaticResource Check}" Content="Rename"              Margin="0,4"/>
                    <CheckBox x:Name="chkStrings"        Style="{StaticResource Check}" Content="Encrypt strings"     Margin="0,4"/>
                    <CheckBox x:Name="chkConstants"      Style="{StaticResource Check}" Content="Encrypt constants"   Margin="0,4"/>
                    <CheckBox x:Name="chkMutate"         Style="{StaticResource Check}" Content="MBA mutation"        Margin="0,4"/>
                    <CheckBox x:Name="chkEncode"         Style="{StaticResource Check}" Content="Encode locals"       Margin="0,4"/>
                    <CheckBox x:Name="chkProxy"          Style="{StaticResource Check}" Content="Proxy calls"         Margin="0,4"/>
                    <CheckBox x:Name="chkFlatten"        Style="{StaticResource Check}" Content="Control-flow flatten" Margin="0,4"/>
                    <CheckBox x:Name="chkFlow"           Style="{StaticResource Check}" Content="Opaque predicates"   Margin="0,4"/>
                    <CheckBox x:Name="chkAntiDebug"      Style="{StaticResource Check}" Content="Anti-debug"          Margin="0,4"/>
                    <CheckBox x:Name="chkAntiTamper"     Style="{StaticResource Check}" Content="Anti-tamper"         Margin="0,4"/>
                    <CheckBox x:Name="chkAntiDecompiler" Style="{StaticResource Check}" Content="Anti-decompiler"     Margin="0,4"/>
                    <CheckBox x:Name="chkBomb"           Style="{StaticResource Check}" Content="Decompiler bombs"    Margin="0,4"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- ===== Output card ===== -->
        <Border Grid.Row="3" Background="{StaticResource Surface}" CornerRadius="14" Padding="18"
                BorderBrush="{StaticResource Border}" BorderThickness="1" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="OUTPUT ASSEMBLY" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecond}" Margin="2,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtOutput" Grid.Column="0" Height="44" Style="{StaticResource Field}"
                             ToolTip="Where to save the obfuscated .dll"/>
                    <Button x:Name="btnExport" Grid.Column="1" Content="Export" Width="96" Height="44"
                            Margin="10,0,0,0" Style="{StaticResource GhostButton}" Click="Export_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ===== Obfuscate button ===== -->
        <Button x:Name="btnObfuscate" Grid.Row="4" Content="Obfuscate" Height="52"
                Style="{StaticResource AccentButton}" FontSize="15" Click="Obfuscate_Click" Margin="0,0,0,14"/>

        <!-- ===== Status / log ===== -->
        <Border Grid.Row="5" Background="{StaticResource Surface}" CornerRadius="14"
                BorderBrush="{StaticResource Border}" BorderThickness="1">
            <Grid Margin="18,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="txtStatus" Grid.Row="0" Text="Ready." FontSize="13" FontWeight="Medium"
                           Foreground="{StaticResource TextSecond}" Margin="0,0,0,10"/>
                <Border Grid.Row="1" Background="{StaticResource Bg}" CornerRadius="10" Padding="12">
                    <ScrollViewer x:Name="logScroller" VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="txtLog" Background="Transparent" BorderThickness="0" IsReadOnly="True"
                                 Foreground="{StaticResource TextSecond}" FontFamily="Consolas" FontSize="12"
                                 TextWrapping="Wrap" Text=""/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
